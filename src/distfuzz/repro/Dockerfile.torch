# distfuzz.repro pinned environment: one image per PyTorch wheel version.
# Base image pinned by digest (python:3.12-slim as pulled 2026-09-19).
FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
ARG TORCH_SPEC
ARG NUMPY_SPEC=numpy==2.2.6
ARG INDEX_URL=https://download.pytorch.org/whl/cpu
ARG PIP_EXTRA=""
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends procps && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir $PIP_EXTRA "$NUMPY_SPEC" "$TORCH_SPEC" \
        --index-url "$INDEX_URL" --extra-index-url https://pypi.org/simple \
 && pip freeze > /pinned-requirements.txt \
 && python -c "import torch; print(torch.__version__)" > /torch-version.txt
WORKDIR /repro
